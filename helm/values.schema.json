{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values of the markets chart",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicaCount", "service", "metrics", "existingSecret", "env", "trading", "runtime", "resources", "probes", "networkPolicy", "smokeTest"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1, "maximum": 5 },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "metrics": {
      "type": "object",
      "description": "GET /metrics is served on this port, never on service.port (the template refuses equal ports).",
      "additionalProperties": false,
      "required": ["port"],
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "podAnnotations": {
      "type": "object",
      "description": "The prometheus.io/* annotations are set by the chart from metrics.port; they cannot be set here.",
      "propertyNames": { "not": { "pattern": "^prometheus\\.io/" } },
      "additionalProperties": { "type": "string" }
    },
    "existingSecret": { "type": "string", "minLength": 1 },
    "env": {
      "type": "object",
      "description": "Non-secret startup settings only. Secrets belong in the Secret named by existingSecret; PORT, METRICS_PORT, TRADING_URL and RUNTIME_CONFIG_FILE are rendered by the chart; the runtime keys have their own block; FAKE_FUNDING_MODE exists only for APP_ENV=local, never in a cluster.",
      "propertyNames": {
        "pattern": "^[A-Z][A-Z0-9_]*$",
        "not": {
          "enum": [
            "DATABASE_URL",
            "MARKETS_CLIENT_SECRET",
            "PORT",
            "METRICS_PORT",
            "TRADING_URL",
            "RUNTIME_CONFIG_FILE",
            "FAKE_FUNDING_MODE",
            "LOG_LEVEL",
            "MARKET_FUNDING_MIN",
            "MARKET_FUNDING_MAX",
            "MARKET_MIN_LEAD_MS",
            "AUTO_CLOSE_ENABLED",
            "AUTO_CLOSE_INTERVAL_MS"
          ]
        }
      },
      "properties": {
        "STREAM_MAX_AGE_DAYS": { "type": "string", "pattern": "^([1-9][0-9]?|[12][0-9]{2}|3[0-5][0-9]|36[0-5])$", "description": "1 to 365 (days), as src/config.ts accepts" }
      },
      "additionalProperties": { "type": "string" }
    },
    "trading": {
      "type": "object",
      "description": "Trading's internal funding endpoint: TRADING_URL is http://host:port and the NetworkPolicy opens this port.",
      "additionalProperties": false,
      "required": ["host", "port"],
      "properties": {
        "host": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "runtime": {
      "type": "object",
      "description": "The keys the service applies while it runs (ADR-037); rendered into the ConfigMap <release>-runtime, whose change does not restart the Pods. Values are strings.",
      "additionalProperties": false,
      "properties": {
        "LOG_LEVEL": { "type": "string", "enum": ["fatal", "error", "warn", "info", "debug", "trace", "silent"] },
        "MARKET_FUNDING_MIN": { "type": "string", "pattern": "^([1-9][0-9]{0,5}|1000000)$", "description": "1 to 1000000, as src/config.ts accepts; must not exceed MARKET_FUNDING_MAX" },
        "MARKET_FUNDING_MAX": { "type": "string", "pattern": "^([1-9][0-9]{0,5}|1000000)$", "description": "1 to 1000000, as src/config.ts accepts" },
        "MARKET_MIN_LEAD_MS": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,7}|[1-5][0-9]{8}|60[0-3][0-9]{6}|604[0-7][0-9]{5}|604800000)$", "description": "0 to 604800000 (7 days), as src/config.ts accepts" },
        "AUTO_CLOSE_ENABLED": { "type": "string", "enum": ["true", "false"], "description": "The kill switch of the automatic close at the close time (UC-15): false closes nothing. An invalid or empty value edited into the runtime ConfigMap also switches it off (fails closed)" },
        "AUTO_CLOSE_INTERVAL_MS": { "type": "string", "pattern": "^(1[0-9]{3}|[2-9][0-9]{3}|[1-9][0-9]{4,5}|[12][0-9]{6}|3[0-5][0-9]{5}|3600000)$", "description": "1000 to 3600000, as src/config.ts accepts: the wait between two runs of the automatic close" }
      }
    },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startup", "readiness", "liveness"],
      "properties": {
        "startup": { "$ref": "#/definitions/probe" },
        "readiness": { "$ref": "#/definitions/probe" },
        "liveness": { "$ref": "#/definitions/probe" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "gatewayNamespaceLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "gatewayPodLabels": { "type": "object", "additionalProperties": { "type": "string" } },
        "metrics": {
          "type": "object",
          "description": "The namespace of Prometheus, admitted on the metrics port only.",
          "additionalProperties": false,
          "required": ["namespace"],
          "properties": { "namespace": { "type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$" } }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["postgres", "nats", "keycloak", "trading", "dnsNamespaceLabels"],
          "properties": {
            "postgres": { "$ref": "#/definitions/destinationWithPort" },
            "nats": { "$ref": "#/definitions/destinationWithPort" },
            "keycloak": { "$ref": "#/definitions/destinationWithPort" },
            "trading": { "$ref": "#/definitions/destination" },
            "dnsNamespaceLabels": { "$ref": "#/definitions/labels" }
          }
        }
      }
    },
    "smokeTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": { "image": { "type": "string", "minLength": 1 } }
    }
  },
  "definitions": {
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "periodSeconds", "failureThreshold"],
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "periodSeconds": { "type": "integer", "minimum": 1 },
        "failureThreshold": { "type": "integer", "minimum": 1 }
      }
    },
    "labels": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string" }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["podLabels"],
      "properties": { "podLabels": { "$ref": "#/definitions/labels" } }
    },
    "destinationWithPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["podLabels", "port"],
      "properties": {
        "podLabels": { "$ref": "#/definitions/labels" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
